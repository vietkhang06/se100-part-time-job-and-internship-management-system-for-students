{
  "name": "campusjob",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "predev": "pnpm --filter @campusjob/contracts build",
    "pretypecheck": "pnpm --filter @campusjob/contracts build",
    "pretest": "pnpm --filter @campusjob/contracts build",
    "dev": "concurrently -n API,WEB -c blue,magenta \"pnpm --filter @campusjob/api start:dev\" \"pnpm --filter @campusjob/web dev\"",
    "dev:api": "pnpm --filter @campusjob/api start:dev",
    "dev:web": "pnpm --filter @campusjob/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @campusjob/api test:e2e",
    "test:e2e:m02": "pnpm --filter @campusjob/api exec jest --config test/jest-m02-e2e.json --runInBand --forceExit",
    "test:m04:postgres": "pnpm --filter @campusjob/api exec jest --config test/jest-m04-postgres.json --runInBand",
    "db:validate": "dotenv -e .env -- pnpm --filter @campusjob/api exec prisma validate --schema prisma/schema.prisma",
    "db:generate": "pnpm --filter @campusjob/api exec prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- pnpm --filter @campusjob/api exec prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "dotenv -e .env -- pnpm --filter @campusjob/api exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "dotenv -e .env -- pnpm --filter @campusjob/api exec prisma studio --schema prisma/schema.prisma",
    "admin:create": "dotenv -e .env -- pnpm --filter @campusjob/api admin:create",
    "infra:config": "docker compose --env-file .env -f infra/docker-compose.yml config",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.2.1",
    "typescript": "^5.7.2"
  }
}
