NODE_ENV=development

API_PORT=8080
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

POSTGRES_DB=campusjob
POSTGRES_USER=campusjob
POSTGRES_PASSWORD=campusjob_dev
POSTGRES_PORT=5435
DATABASE_URL=postgresql://campusjob:campusjob_dev@localhost:5435/campusjob?schema=public

# Required: generate a private value for JWT access-token signing and verification.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Optional; refresh tokens are random opaque session tokens, not JWTs.
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_NAME=campusjob_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=no-reply@campusjob.local
MAILPIT_WEB_PORT=8026

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./var/uploads
MAX_UPLOAD_SIZE_MB=10

MAINTENANCE_SECRET=replace_with_long_random_maintenance_secret
