datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  EMPLOYER
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
}

enum JobSeekingStatus {
  ACTIVELY_LOOKING
  OPEN_FOR_OPPORTUNITIES
  NOT_LOOKING
}

enum NotificationEmailStatus {
  NOT_REQUIRED
  PENDING
  SENT
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  ONSITE
  ONLINE
}

enum InterviewResult {
  ACCEPTED
  REJECTED
}

enum InterviewChangeDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  phone                   String?
  role                    UserRole
  status                  UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  studentProfile          StudentProfile?
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
  @@index([status])
}

model StudentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  university       String?
  major            String?
  graduationYear   Int?
  jobSeekingStatus JobSeekingStatus @default(ACTIVELY_LOOKING)
  bio              String?
  skills           String[]         @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  cvs              Cv[]

  @@index([userId])
  @@index([jobSeekingStatus])
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenFamily String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([tokenFamily])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// M05 · Notification (C-20)
// recipientId cố ý KHÔNG khai báo FK sang User để không sửa model của M01.
// Tính toàn vẹn được kiểm tra ở tầng use case; có thể thêm FK sau khi Lead đồng ý.
// ============================================================================
model Notification {
  id               String                  @id @default(uuid())
  recipientId      String
  eventType        String
  title            String
  body             String
  payload          Json?
  dedupeKey        String?                 @unique
  readAt           DateTime?
  emailStatus      NotificationEmailStatus @default(NOT_REQUIRED)
  emailAttempts    Int                     @default(0)
  emailLastError   String?
  emailSentAt      DateTime?
  emailNextRetryAt DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([recipientId, readAt, createdAt])
  @@index([emailStatus, emailNextRetryAt])
}

// ============================================================================
// M04 · Application & Interview
// M04 owns these records. studentId, jobId and cvId remain scalar contract IDs
// until M02/M03 publish their persistence models; M04 never owns their data.
// ============================================================================
model Application {
  id              String                     @id @default(uuid())
  studentId       String
  jobId           String
  cvId            String
  cvSnapshot      Json
  coverLetter     String?
  status          ApplicationStatus          @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  statusHistory   ApplicationStatusHistory[]
  interviews      Interview[]

  @@unique([studentId, jobId])
  @@index([studentId, status])
  @@index([jobId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model Interview {
  id             String                  @id @default(uuid())
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  mode           InterviewMode
  locationOrLink String
  message        String?
  confirmedAt    DateTime?
  result         InterviewResult?
  resultAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  changeRequest  InterviewChangeRequest?

  @@index([applicationId, scheduledAt])
}

model InterviewChangeRequest {
  id          String                  @id @default(uuid())
  interviewId String                  @unique
  interview   Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  proposedAt  DateTime
  message     String?
  decision    InterviewChangeDecision @default(PENDING)
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())
}

// ============================================================================
// M02 · CV & Resume
// ============================================================================
model Cv {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  isDefault        Boolean        @default(false)
  fileUrl          String?
  skills           String[]       @default([])
  educations       Json           @default("[]")
  experiences      Json           @default("[]")
  projects         Json           @default("[]")
  certifications   Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([studentProfileId])
  @@index([studentProfileId, isDefault])
}

// ============================================================================
// M05 · Moderation (C-16)
// targetId/submitterId/assigneeId/reviewerId là String thường (không FK) để không sửa model của module khác.
// ============================================================================
enum ModerationTargetType {
  JOB
  REPORT
  REVIEW
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  RESTORED
  SUBSTANTIATED
  DISMISSED
}

enum ModerationDecisionType {
  APPROVE
  REJECT
  HIDE
  RESTORE
  SUBSTANTIATE
  DISMISS
}

model ModerationItem {
  id          String               @id @default(uuid())
  targetType  ModerationTargetType
  targetId    String
  round       Int                  @default(1)
  status      ModerationStatus     @default(PENDING)
  summary     String?
  submitterId String?
  assigneeId  String?
  assignedAt  DateTime?
  enqueuedAt  DateTime             @default(now())
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  decisions ModerationDecision[]

  @@unique([targetType, targetId, round])
  @@index([status, targetType, enqueuedAt])
  @@index([assigneeId])
}

model ModerationDecision {
  id              String                 @id @default(uuid())
  itemId          String
  item            ModerationItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  decision        ModerationDecisionType
  reason          String?
  proposedAction  String?
  reviewerId      String
  targetSyncedAt  DateTime?
  targetSyncError String?
  createdAt       DateTime               @default(now())

  @@index([itemId])
  @@index([targetSyncedAt])
}
