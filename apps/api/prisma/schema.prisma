datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  EMPLOYER
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
}

enum JobSeekingStatus {
  ACTIVELY_LOOKING
  OPEN_FOR_OPPORTUNITIES
  NOT_LOOKING
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  phone                   String?
  role                    UserRole
  status                  UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  studentProfile          StudentProfile?
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
  @@index([status])
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenFamily String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([tokenFamily])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model StudentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  university       String?
  major            String?
  graduationYear   Int?
  jobSeekingStatus JobSeekingStatus @default(ACTIVELY_LOOKING)
  bio              String?
  skills           String[]         @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([jobSeekingStatus])
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// M04 owns these records. studentId, jobId and cvId remain scalar contract IDs
// until M02/M03 publish their persistence models; M04 never owns their data.
model Application {
  id              String                     @id @default(uuid())
  studentId       String
  jobId           String
  cvId            String
  cvSnapshot      Json
  coverLetter     String?
  status          ApplicationStatus          @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  statusHistory   ApplicationStatusHistory[]

  @@unique([studentId, jobId])
  @@index([studentId, status])
  @@index([jobId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}
