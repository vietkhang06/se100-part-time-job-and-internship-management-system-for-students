datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  EMPLOYER
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
}

enum JobSeekingStatus {
  ACTIVELY_LOOKING
  OPEN_FOR_OPPORTUNITIES
  NOT_LOOKING
}

enum NotificationEmailStatus {
  NOT_REQUIRED
  PENDING
  SENT
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  ONSITE
  ONLINE
}

enum InterviewResult {
  ACCEPTED
  REJECTED
}

enum InterviewChangeDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                           String                   @id @default(uuid())
  email                        String                   @unique
  passwordHash                 String
  fullName                     String
  phone                        String?
  role                         UserRole
  status                       UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt              DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  studentProfile               StudentProfile?
  authSessions                 AuthSession[]
  emailVerificationTokens      EmailVerificationToken[]
  passwordResetTokens          PasswordResetToken[]
  auditLogs                    AuditLog[]                @relation("ActorAuditLogs")
  fileAssets                   FileAsset[]
  companyMemberships           CompanyMember[]
  reviewedCompanyVerifications CompanyVerification[]     @relation("ReviewedCompanyVerifications")

  @@index([email])
  @@index([role])
  @@index([status])
}

model StudentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  university       String?
  major            String?
  graduationYear   Int?
  jobSeekingStatus JobSeekingStatus @default(ACTIVELY_LOOKING)
  bio              String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentSkills    StudentSkill[]
  cvs              Cv[]

  @@index([userId])
  @@index([jobSeekingStatus])
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenFamily String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([tokenFamily])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// M05 · Notification (C-20)
// recipientId cố ý KHÔNG khai báo FK sang User để không sửa model của M01.
// Tính toàn vẹn được kiểm tra ở tầng use case; có thể thêm FK sau khi Lead đồng ý.
// ============================================================================
model Notification {
  id               String                  @id @default(uuid())
  recipientId      String
  eventType        String
  title            String
  body             String
  payload          Json?
  dedupeKey        String?                 @unique
  readAt           DateTime?
  emailStatus      NotificationEmailStatus @default(NOT_REQUIRED)
  emailAttempts    Int                     @default(0)
  emailLastError   String?
  emailSentAt      DateTime?
  emailNextRetryAt DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([recipientId, readAt, createdAt])
  @@index([emailStatus, emailNextRetryAt])
}

// ============================================================================
// M04 · Application & Interview
// M04 owns these records. studentId, jobId and cvId remain scalar contract IDs
// until M02/M03 publish their persistence models; M04 never owns their data.
// ============================================================================
model Application {
  id              String                     @id @default(uuid())
  studentId       String
  jobId           String
  cvId            String
  cvSnapshot      Json
  coverLetter     String?
  status          ApplicationStatus          @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  statusHistory   ApplicationStatusHistory[]
  interviews      Interview[]

  @@unique([studentId, jobId])
  @@index([studentId, status])
  @@index([jobId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model Interview {
  id             String                  @id @default(uuid())
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  mode           InterviewMode
  locationOrLink String
  message        String?
  confirmedAt    DateTime?
  result         InterviewResult?
  resultAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  changeRequest  InterviewChangeRequest?

  @@index([applicationId, scheduledAt])
}

model InterviewChangeRequest {
  id          String                  @id @default(uuid())
  interviewId String                  @unique
  interview   Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  proposedAt  DateTime
  message     String?
  decision    InterviewChangeDecision @default(PENDING)
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())
}

// ============================================================================
// M02 · CV & Resume
// ============================================================================
model Cv {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  isDefault        Boolean        @default(false)
  fileUrl          String?
  fileAssetId      String?        @unique
  fileAsset        FileAsset?     @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  skills           String[]       @default([])
  educations       Json           @default("[]")
  experiences      Json           @default("[]")
  projects         Json           @default("[]")
  certifications   Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([studentProfileId])
  @@index([studentProfileId, isDefault])
}

// ============================================================================
// Normalized Skills (W2-DB-01)
// ============================================================================
model Skill {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  studentSkills  StudentSkill[]

  @@index([normalizedName])
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  skillId          String
  createdAt        DateTime       @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

// ============================================================================
// File Assets & Metadata (W2-DB-02 / W2-DO-01)
// ============================================================================
enum FileAssetStatus {
  PENDING_UPLOAD
  PERMANENT
  PENDING_DELETION
}

model FileAsset {
  id                            String          @id @default(uuid())
  ownerUserId                   String
  ownerUser                     User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  originalName                  String?
  mimeType                      String
  sizeBytes                     Int
  checksumSha256                String
  storageKey                    String          @unique
  status                        FileAssetStatus @default(PERMANENT)
  uploadedAt                    DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  cv                            Cv?
  companyVerificationDocuments  CompanyVerificationDocument[]

  @@index([ownerUserId])
  @@index([storageKey])
  @@index([status])
}

// ============================================================================
// Companies & Verification (W2-DB-03)
// ============================================================================
enum CompanyMemberRole {
  OWNER
  ADMIN
  HR_MANAGER
  RECRUITER
  MEMBER
}

enum CompanyMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAX_REGISTRATION
  OPERATION_PERMIT
  OTHER
}

model Company {
  id                 String                    @id @default(uuid())
  name               String
  legalName          String?
  taxId              String                    @unique
  website             String?
  industry            String?
  companySize         String?
  description         String?
  logoUrl             String?
  email               String?
  phone               String?
  address              String?
  verificationStatus String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  members             CompanyMember[]
  branches             CompanyBranch[]
  verifications        CompanyVerification[]

  @@index([name])
  @@index([taxId])
  @@index([verificationStatus])
}

model CompanyMember {
  id        String              @id @default(uuid())
  companyId String
  userId    String
  role      CompanyMemberRole   @default(MEMBER)
  status    CompanyMemberStatus @default(ACTIVE)
  joinedAt  DateTime            @default(now())
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([role])
}

model CompanyBranch {
  id            String   @id @default(uuid())
  companyId     String
  branchName    String
  addressLine   String
  ward          String?
  district      String?
  city          String
  country       String   @default("Vietnam")
  phone          String?
  email          String?
  isHeadquarter Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([city])
}

model CompanyVerification {
  id              String                    @id @default(uuid())
  companyId       String
  reviewerId      String?
  status          CompanyVerificationStatus @default(PENDING_REVIEW)
  rejectionReason String?
  submittedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer        User?                     @relation("ReviewedCompanyVerifications", fields: [reviewerId], references: [id], onDelete: SetNull)
  documents       CompanyVerificationDocument[]

  @@index([companyId])
  @@index([reviewerId])
  @@index([status])
}

model CompanyVerificationDocument {
  id             String              @id @default(uuid())
  verificationId String
  fileAssetId    String
  documentType   DocumentType        @default(BUSINESS_LICENSE)
  createdAt      DateTime            @default(now())

  verification   CompanyVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset           @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([verificationId, fileAssetId])
  @@index([verificationId])
  @@index([fileAssetId])
}

// ============================================================================
// M05 · Moderation (C-16)
// targetId/submitterId/assigneeId/reviewerId là String thường (không FK) để không sửa model của module khác.
// ============================================================================
enum ModerationTargetType {
  JOB
  REPORT
  REVIEW
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  RESTORED
  SUBSTANTIATED
  DISMISSED
}

enum ModerationDecisionType {
  APPROVE
  REJECT
  HIDE
  RESTORE
  SUBSTANTIATE
  DISMISS
}

model ModerationItem {
  id          String               @id @default(uuid())
  targetType  ModerationTargetType
  targetId    String
  round       Int                  @default(1)
  status      ModerationStatus     @default(PENDING)
  summary     String?
  submitterId String?
  assigneeId  String?
  assignedAt  DateTime?
  enqueuedAt  DateTime             @default(now())
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  decisions   ModerationDecision[]

  @@unique([targetType, targetId, round])
  @@index([status, targetType, enqueuedAt])
  @@index([assigneeId])
}

model ModerationDecision {
  id              String                 @id @default(uuid())
  itemId          String
  item            ModerationItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  decision        ModerationDecisionType
  reason          String?
  proposedAction  String?
  reviewerId      String
  targetSyncedAt  DateTime?
  targetSyncError String?
  createdAt       DateTime               @default(now())

  @@index([itemId])
  @@index([targetSyncedAt])
}