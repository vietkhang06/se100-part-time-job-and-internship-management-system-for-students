{
  "rootDir": "../../../packages/contracts",
  "testMatch": ["<rootDir>/src/**/*.spec.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": { "types": ["jest", "node"], "esModuleInterop": true } }
    ]
  },
  "testEnvironment": "node"
}
